  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1216640442}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 53b54af8093a17246992f34701cee8ea, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  perguntas:
  - enunciado: "Em C, com <b>unsigned short</b> de 16 bits, quanto d\xE1 <b>3 - 5</b>?"
    alternativas:
    - 65534
    - -2
    - 65535
    indiceCorreta: 0
    explicacao: "N\xE3o existe negativo em unsigned: -2 + 2<sup>16</sup> = 65534
      (wraparound)."
  - enunciado: "Quanto vale o n\xFAmero bin\xE1rio <b>1010</b> em decimal?"
    alternativas:
    - 10
    - 12
    - 5
    indiceCorreta: 0
    explicacao: 8 + 2 = 10.
  - enunciado: Quantos bits tem <b>1 byte</b>?
    alternativas:
    - 8
    - 16
    - 4
    indiceCorreta: 0
    explicacao: 1 byte = 8 bits.
  - enunciado: "Qual estrutura de dados segue a regra <b>\"o \xFAltimo a entrar \xE9
      o primeiro a sair\"</b> (LIFO)?"
    alternativas:
    - Pilha
    - Fila
    - "\xC1rvore"
    indiceCorreta: 0
    explicacao: Pilha = LIFO. Fila = FIFO.
  - enunciado: "Qual a complexidade da <b>busca bin\xE1ria</b> num vetor ordenado
      com n elementos?"
    alternativas:
    - O(log n)
    - O(n)
    - "O(n\xB2)"
    indiceCorreta: 0
    explicacao: A cada passo ela descarta metade do vetor.
  - enunciado: "Qual porta l\xF3gica d\xE1 <b>1</b> s\xF3 quando as duas entradas
      s\xE3o <b>diferentes</b>?"
    alternativas:
    - XOR
    - AND
    - NOR
    indiceCorreta: 0
    explicacao: XOR = "ou exclusivo".
  - enunciado: Quanto vale <b>FF</b> (hexadecimal) em decimal?
    alternativas:
    - 255
    - 256
    - 15
    indiceCorreta: 0
    explicacao: "15 \xD7 16 + 15 = 255."
  - enunciado: "Quem descreveu a <b>m\xE1quina universal</b> e \xE9 chamado de pai
      da Ci\xEAncia da Computa\xE7\xE3o?"
    alternativas:
    - Alan Turing
    - Charles Babbage
    - Bill Gates
    indiceCorreta: 0
    explicacao: Turing publicou a ideia em 1936.
  - enunciado: "Qual destas mem\xF3rias \xE9 a <b>mais r\xE1pida</b>?"
    alternativas:
    - Registradores da CPU
    - "Mem\xF3ria RAM"
    - SSD
    indiceCorreta: 0
    explicacao: Os registradores ficam dentro do processador.
  - enunciado: Em complemento de 2 com 8 bits, como se escreve <b>-1</b>?
    alternativas:
    - 11111111
    - 10000001
    - 00000001
    indiceCorreta: 0
    explicacao: Inverte 00000001 e soma 1.
  - enunciado: "Em C, quanto d\xE1 <b>7 % 3</b>?"
    alternativas:
    - 1
    - 2
    - 2,33
    indiceCorreta: 0
    explicacao: "% \xE9 o resto da divis\xE3o: 7 = 2 \xD7 3 + 1."
  - enunciado: Uma matriz <b>2x3</b> vezes uma matriz <b>3x4</b> gera uma matriz
      de que tamanho?
    alternativas:
    - 2x4
    - 3x3
    - 4x2
    indiceCorreta: 0
    explicacao: "Linhas da primeira \xD7 colunas da segunda."
  - enunciado: "No modelo de <b>von Neumann</b>, dados e instru\xE7\xF5es ficam..."
    alternativas:
    - "Na mesma mem\xF3ria"
    - "Em mem\xF3rias separadas"
    - "S\xF3 dentro da CPU"
    indiceCorreta: 0
    explicacao: "Arquitetura separada \xE9 a de Harvard."
  - enunciado: Quanto vale <b>(1 AND 0) OR 1</b>?
    alternativas:
    - 1
    - 0
    - Indefinido
    indiceCorreta: 0
    explicacao: 1 AND 0 = 0; depois 0 OR 1 = 1.
  teclaInteragir: 101
  painelQuadro: {fileID: 620470847}
  textoPergunta: {fileID: 1371138543}
